@page "/Anket/{token}"
@model HastaMemnuniyet.Web.Pages.Anket.IndexModel
@{
    ViewData["Title"] = Model.Anket?.Ad ?? "Anket";
    Layout = "_AnketLayout";
}

@if (Model.Anket is not null)
{
    <div class="anket-kart mx-auto">
        <div class="text-center mb-4">
            <i class="bi bi-clipboard2-heart display-4 text-primary"></i>
            <h1 class="h3 mt-3">@Model.Anket.Ad</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Anket.Aciklama))
        {
            <p class="lead text-center">@Model.Anket.Aciklama</p>
        }

        <div class="row text-center g-3 my-4">
            <div class="col-6">
                <div class="border rounded p-3">
                    <div class="fs-4 fw-bold text-primary">@Model.Anket.SoruSayisi</div>
                    <div class="text-muted small">Soru</div>
                </div>
            </div>
            <div class="col-6">
                <div class="border rounded p-3">
                    <div class="fs-4 fw-bold text-primary">@(Model.Anket.TahminiSureDakika > 0 ? Model.Anket.TahminiSureDakika.ToString() : "~2")</div>
                    <div class="text-muted small">Dakika</div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Anket.GizlilikMetni))
        {
            <div class="alert alert-light border small">
                <i class="bi bi-shield-lock me-1"></i> @Model.Anket.GizlilikMetni
            </div>
        }

        <div class="d-grid mt-4">
            <a asp-page="Doldur" asp-route-token="@Model.Token" class="btn btn-primary btn-lg">
                <i class="bi bi-pencil-square me-1"></i> Ankete Başla
            </a>
        </div>
    </div>
}
