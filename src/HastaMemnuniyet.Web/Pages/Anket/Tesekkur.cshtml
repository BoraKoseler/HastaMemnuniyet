@page "/Anket/{token}/Tesekkur"
@model HastaMemnuniyet.Web.Pages.Anket.TesekkurModel
@{
    ViewData["Title"] = "Teşekkürler";
    Layout = "_AnketLayout";
}

<div class="anket-kart text-center">
    <div class="mb-3">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
    </div>
    <h1 class="h3 mb-3">Teşekkür Ederiz!</h1>
    <p class="lead text-muted mb-2">
        Anketimizi doldurduğunuz için çok teşekkür ederiz.
    </p>
    <p class="text-muted mb-0">
        Görüşleriniz, sağlık hizmetlerimizi geliştirmek için bizim için çok değerlidir.
        Bu pencereyi güvenle kapatabilirsiniz.
    </p>
</div>
