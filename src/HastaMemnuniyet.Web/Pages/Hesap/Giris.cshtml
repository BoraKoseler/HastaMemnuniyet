@page
@model HastaMemnuniyet.Web.Pages.Hesap.GirisModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-heart-pulse-fill text-primary" style="font-size:2.5rem;"></i>
                    <h1 class="h4 mt-2 mb-0">Giriş Yap</h1>
                    <p class="text-muted small">Hasta Memnuniyet Yönetim Sistemi</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                         style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

                    <div class="mb-3">
                        <label asp-for="Girdi.Eposta" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Girdi.Eposta" class="form-control" autocomplete="username" placeholder="ornek@hastamemnuniyet.com" />
                        </div>
                        <span asp-validation-for="Girdi.Eposta" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Girdi.Parola" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Girdi.Parola" class="form-control" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Girdi.Parola" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Girdi.BeniHatirla" class="form-check-input" />
                        <label asp-for="Girdi.BeniHatirla" class="form-check-label"></label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <p class="text-center text-muted small mt-3">
            <a asp-page="/Index" class="text-decoration-none">&larr; Ana sayfaya dön</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
