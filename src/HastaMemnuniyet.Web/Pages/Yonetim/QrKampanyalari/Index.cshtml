@page
@model HastaMemnuniyet.Web.Pages.Yonetim.QrKampanyalari.IndexModel
@{
    ViewData["Title"] = "QR Kampanyaları";
}

<div class="sayfa-baslik d-flex justify-content-between align-items-center flex-wrap">
    <h1><i class="bi bi-qr-code me-2"></i>QR Anket Kampanyaları</h1>
    <a asp-page="Ekle" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Yeni Kampanya</a>
</div>

@if (Model.Kampanyalar.Count == 0)
{
    <div class="alert alert-info">Henüz QR kampanyası oluşturulmamış.</div>
}
else
{
    <div class="row g-3">
        @foreach (var kampanya in Model.Kampanyalar)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <h2 class="h5">@kampanya.Ad</h2>
                        <div class="text-muted small mb-2">
                            @(kampanya.AnketAdi ?? "-") · @(kampanya.HastaneAdi ?? "-")
                            @if (!string.IsNullOrWhiteSpace(kampanya.BirimAdi))
                            {
                                <span>· @kampanya.BirimAdi</span>
                            }
                        </div>
                        <img src="@Url.Page("Index", "QrKodu", new { id = kampanya.Id })"
                             alt="QR Kod: @kampanya.Ad" class="img-fluid border rounded mb-2" style="max-width: 200px;" />
                        <div class="mb-2">
                            @if (kampanya.AktifMi)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                            <span class="badge bg-info text-dark">Kullanım: @kampanya.KullanimSayisi</span>
                        </div>
                        @if (kampanya.SonKullanmaTarihi.HasValue)
                        {
                            <div class="small text-muted">Son kullanma: @kampanya.SonKullanmaTarihi.Value.ToString("dd.MM.yyyy")</div>
                        }
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between">
                        <a href="@Url.Page("Index", "QrKodu", new { id = kampanya.Id })" download="qr-kampanya-@(kampanya.Id).png" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-download me-1"></i> QR İndir
                        </a>
                        <form method="post" asp-page-handler="Aktiflik">
                            <input type="hidden" name="id" value="@kampanya.Id" />
                            <input type="hidden" name="aktifMi" value="@((!kampanya.AktifMi).ToString().ToLowerInvariant())" />
                            @if (kampanya.AktifMi)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pause-circle me-1"></i> Pasifleştir</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-play-circle me-1"></i> Aktifleştir</button>
                            }
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
