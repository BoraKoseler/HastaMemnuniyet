@page
@model HastaMemnuniyet.Web.Pages.Yonetim.QrKampanyalari.EkleModel
@{
    ViewData["Title"] = "Yeni QR Kampanyası";
}

<div class="sayfa-baslik d-flex justify-content-between align-items-center flex-wrap">
    <h1><i class="bi bi-plus-circle me-2"></i>Yeni QR Kampanyası</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="form-kart">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Girdi.Ad" class="form-label"></label>
            <input asp-for="Girdi.Ad" class="form-control" />
            <span asp-validation-for="Girdi.Ad" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.AnketId" class="form-label"></label>
                <select asp-for="Girdi.AnketId" asp-items="Model.AnketSecenekleri" class="form-select">
                    <option value="">Seçiniz...</option>
                </select>
                <span asp-validation-for="Girdi.AnketId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.HastaneId" class="form-label"></label>
                <select asp-for="Girdi.HastaneId" asp-items="Model.HastaneSecenekleri" class="form-select" id="hastaneSelect">
                    <option value="">Seçiniz...</option>
                </select>
                <span asp-validation-for="Girdi.HastaneId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.BirimId" class="form-label"></label>
                <select asp-for="Girdi.BirimId" class="form-select" id="birimSelect" disabled>
                    <option value="">(Önce hastane seçiniz)</option>
                </select>
                <span asp-validation-for="Girdi.BirimId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.DoktorId" class="form-label"></label>
                <select asp-for="Girdi.DoktorId" class="form-select" id="doktorSelect" disabled>
                    <option value="">(Önce birim seçiniz)</option>
                </select>
                <span asp-validation-for="Girdi.DoktorId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.SonKullanmaTarihi" class="form-label"></label>
                <input asp-for="Girdi.SonKullanmaTarihi" class="form-control" type="date" />
                <span asp-validation-for="Girdi.SonKullanmaTarihi" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Kaydet</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Hastane -> Birim -> Doktor kademeli dropdown
        (function () {
            var hastaneSel = document.getElementById('hastaneSelect');
            var birimSel = document.getElementById('birimSelect');
            var doktorSel = document.getElementById('doktorSelect');

            function sifirla(sel, varsayilanMetin) {
                sel.innerHTML = '<option value="">' + varsayilanMetin + '</option>';
                sel.disabled = true;
            }

            hastaneSel.addEventListener('change', function () {
                sifirla(doktorSel, '(Önce birim seçiniz)');
                var hastaneId = this.value;
                if (!hastaneId) {
                    sifirla(birimSel, '(Önce hastane seçiniz)');
                    return;
                }
                fetch('/api/birimler?hastaneId=' + hastaneId)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        birimSel.innerHTML = '<option value="">(İsteğe bağlı)</option>';
                        data.forEach(function (b) {
                            var opt = document.createElement('option');
                            opt.value = b.id;
                            opt.textContent = b.ad;
                            birimSel.appendChild(opt);
                        });
                        birimSel.disabled = false;
                    });
            });

            birimSel.addEventListener('change', function () {
                var birimId = this.value;
                if (!birimId) {
                    sifirla(doktorSel, '(Önce birim seçiniz)');
                    return;
                }
                fetch('/api/doktorlar?birimId=' + birimId)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        doktorSel.innerHTML = '<option value="">(İsteğe bağlı)</option>';
                        data.forEach(function (d) {
                            var opt = document.createElement('option');
                            opt.value = d.id;
                            opt.textContent = d.ad;
                            doktorSel.appendChild(opt);
                        });
                        doktorSel.disabled = false;
                    });
            });
        })();
    </script>
}
