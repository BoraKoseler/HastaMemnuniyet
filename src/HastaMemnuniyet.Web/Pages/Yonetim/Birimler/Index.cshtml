@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Birimler.IndexModel
@{
    ViewData["Title"] = "Birimler";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-diagram-3 me-2"></i>Birimler</h1>
    <a asp-page="Ekle" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Yeni Birim Ekle</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label class="form-label">Hastaneye Göre Filtrele</label>
        <select asp-for="HastaneId" asp-items="Model.HastaneSecenekleri" class="form-select">
            <option value="">Tüm hastaneler</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filtrele</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

@if (Model.Birimler.Count == 0)
{
    <div class="alert alert-info">Gösterilecek birim bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Hastane</th>
                        <th>Birim Adı</th>
                        <th>Kod</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var birim in Model.Birimler)
                    {
                        <tr>
                            <td>@(birim.HastaneAdi ?? "-")</td>
                            <td>@birim.Ad</td>
                            <td><span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(birim.Kod) ? "-" : birim.Kod)</span></td>
                            <td>
                                @if (birim.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Duzenle" asp-route-id="@birim.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
                                <a asp-page="Sil" asp-route-id="@birim.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
