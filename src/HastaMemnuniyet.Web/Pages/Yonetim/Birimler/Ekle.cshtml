@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Birimler.EkleModel
@{
    ViewData["Title"] = "Yeni Birim";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-diagram-3 me-2"></i>Yeni Birim Ekle</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="card shadow-sm form-kart">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

            <div class="mb-3">
                <label asp-for="Girdi.HastaneId" class="form-label">Hastane</label>
                <select asp-for="Girdi.HastaneId" asp-items="Model.HastaneSecenekleri" class="form-select">
                    <option value="">-- Hastane seçiniz --</option>
                </select>
                <span asp-validation-for="Girdi.HastaneId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Ad" class="form-label">Birim Adı</label>
                <input asp-for="Girdi.Ad" class="form-control" />
                <span asp-validation-for="Girdi.Ad" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Kod" class="form-label">Kod</label>
                <input asp-for="Girdi.Kod" class="form-control" />
                <span asp-validation-for="Girdi.Kod" class="text-danger small"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Girdi.AktifMi" class="form-check-input" />
                <label asp-for="Girdi.AktifMi" class="form-check-label">Aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Kaydet</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
