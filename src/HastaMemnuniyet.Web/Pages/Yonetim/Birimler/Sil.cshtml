@page "{id:int}"
@model HastaMemnuniyet.Web.Pages.Yonetim.Birimler.SilModel
@{
    ViewData["Title"] = "Birim Sil";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-trash me-2"></i>Birim Sil</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

@if (Model.Birim is not null)
{
    <div class="card shadow-sm form-kart border-danger">
        <div class="card-body p-4">
            <p class="mb-3"><strong>@Model.Birim.Ad</strong> adlı birimi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
            <dl class="row mb-3">
                <dt class="col-sm-3">Hastane</dt><dd class="col-sm-9">@(Model.Birim.HastaneAdi ?? "-")</dd>
                <dt class="col-sm-3">Birim Adı</dt><dd class="col-sm-9">@Model.Birim.Ad</dd>
                <dt class="col-sm-3">Kod</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Birim.Kod) ? "-" : Model.Birim.Kod)</dd>
            </dl>
            <form method="post">
                <input type="hidden" name="id" value="@Model.Birim.Id" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Evet, Sil</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </form>
        </div>
    </div>
}
