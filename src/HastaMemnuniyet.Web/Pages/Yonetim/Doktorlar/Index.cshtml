@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Doktorlar.IndexModel
@{
    ViewData["Title"] = "Doktorlar";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-person-badge me-2"></i>Doktorlar</h1>
    <a asp-page="Ekle" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Yeni Doktor Ekle</a>
</div>

@if (Model.Doktorlar.Count == 0)
{
    <div class="alert alert-info">Henüz kayıtlı doktor bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Unvan</th>
                        <th>Birimler</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grup in Model.Doktorlar.GroupBy(d => d.Id).OrderBy(g => g.First().Ad))
                    {
                        var doktor = grup.First();
                        var birimler = grup.SelectMany(x => x.BirimAdlari).Distinct().OrderBy(x => x).ToList();
                        <tr>
                            <td>@doktor.Ad @doktor.Soyad</td>
                            <td>@(string.IsNullOrWhiteSpace(doktor.Unvan) ? "-" : doktor.Unvan)</td>
                            <td style="white-space: normal !important; min-width: 280px; max-width: 520px;">
                                <div class="d-flex flex-wrap gap-1">
                                    @if (birimler.Count == 0)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        @foreach (var birimAdi in birimler)
                                        {
                                            <span class="badge bg-light text-dark border fw-normal" style="white-space: normal; text-align: left;">@birimAdi</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td>
                                @if (doktor.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Duzenle" asp-route-id="@doktor.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
                                <a asp-page="Sil" asp-route-id="@doktor.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
