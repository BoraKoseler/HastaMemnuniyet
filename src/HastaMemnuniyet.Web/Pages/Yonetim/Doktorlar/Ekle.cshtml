@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Doktorlar.EkleModel
@{
    ViewData["Title"] = "Yeni Doktor";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-person-badge me-2"></i>Yeni Doktor Ekle</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="card shadow-sm form-kart">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Girdi.Unvan" class="form-label">Unvan</label>
                    <input asp-for="Girdi.Unvan" class="form-control" placeholder="Örn. Uzm. Dr." />
                    <span asp-validation-for="Girdi.Unvan" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Girdi.Ad" class="form-label">Ad</label>
                    <input asp-for="Girdi.Ad" class="form-control" />
                    <span asp-validation-for="Girdi.Ad" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Girdi.Soyad" class="form-label">Soyad</label>
                    <input asp-for="Girdi.Soyad" class="form-control" />
                    <span asp-validation-for="Girdi.Soyad" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Atanacağı Birimler</label>
                @if (Model.BirimGruplari.Count == 0)
                {
                    <div class="alert alert-warning mb-0">Önce birim tanımlamanız gerekir.</div>
                }
                else
                {
                    <div class="border rounded p-3">
                        @foreach (var grup in Model.BirimGruplari)
                        {
                            <div class="mb-3">
                                <div class="fw-semibold text-primary mb-2"><i class="bi bi-hospital me-1"></i>@grup.Key</div>
                                <div class="row">
                                    @foreach (var birim in grup)
                                    {
                                        <div class="col-md-4 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Girdi.BirimIdleri"
                                                       value="@birim.Id" id="birim_@birim.Id"
                                                       checked="@Model.Girdi.BirimIdleri.Contains(birim.Id)" />
                                                <label class="form-check-label" for="birim_@birim.Id">@birim.Ad</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Girdi.AktifMi" class="form-check-input" />
                <label asp-for="Girdi.AktifMi" class="form-check-label">Aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Kaydet</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
