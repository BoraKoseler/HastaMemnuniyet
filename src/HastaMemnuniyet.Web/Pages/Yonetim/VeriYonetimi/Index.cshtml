@page
@model HastaMemnuniyet.Web.Pages.Yonetim.VeriYonetimi.IndexModel
@{
    ViewData["Title"] = "Veri Yönetimi (KVKK)";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-shield-lock me-2"></i>Veri Yönetimi (KVKK)</h1>
</div>

<div class="alert alert-warning" role="alert">
    <i class="bi bi-exclamation-triangle me-1"></i>
    Anonimleştirme işlemi <strong>geri alınamaz</strong>. Kişisel veriler (IP adresi, istemci bilgisi ve
    telefon numarası hash'i) kalıcı olarak silinir. Hukuki uyum için işlem öncesi kurumunuzun ilgili
    birimine (KVKK / hukuk) danışınız.
</div>

@if (!string.IsNullOrWhiteSpace(Model.BasariMesaji))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @Model.BasariMesaji
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.HataMesaji))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @Model.HataMesaji
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Kişisel Veri Saklama Süresi</div>
                <div class="fs-4 fw-semibold">@Model.Ozet.KisiselVeriSaklamaSuresiGun gün</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Yanıt İçeriği Saklama Süresi</div>
                <div class="fs-4 fw-semibold">@Model.Ozet.AnketYanitiSaklamaSuresiGun gün</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Anonimleştirilecek Kayıt</div>
                <div class="fs-4 fw-semibold text-danger">@Model.Ozet.AnonimlestirilecekYanitSayisi</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Anonimleştirilmiş Kayıt</div>
                <div class="fs-4 fw-semibold text-success">@Model.Ozet.AnonimlestirilmisYanitSayisi</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="fw-semibold">Süresi dolan kişisel verileri toplu anonimleştir</div>
            <div class="text-muted small">
                Kişisel veri saklama eşik tarihi: @Model.Ozet.KisiselVeriEsikTarihi.ToString("dd.MM.yyyy") —
                Otomatik anonimleştirme: @(Model.Ozet.OtomatikAnonimlestirmeEtkin ? "Etkin" : "Devre dışı")
            </div>
        </div>
        <form method="post" asp-page-handler="TumunuAnonimlestir"
              onsubmit="return confirm('Süresi dolan TÜM kayıtların kişisel verileri kalıcı olarak silinecek. Bu işlem geri alınamaz. Devam etmek istiyor musunuz?');">
            <button type="submit" class="btn btn-danger" @(Model.Ozet.AnonimlestirilecekYanitSayisi == 0 ? "disabled" : "")>
                <i class="bi bi-eraser me-1"></i> Süresi Dolanları Anonimleştir
            </button>
        </form>
    </div>
</div>

<h2 class="h5 mb-3">Süresi Dolan Kayıtlar</h2>

@if (Model.SuresiDolanlar.Count == 0)
{
    <div class="alert alert-info">Anonimleştirilmesi gereken, süresi dolmuş kişisel veri bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Yanıt No</th>
                        <th>Anket</th>
                        <th>Başlama</th>
                        <th>Tamamlanma</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kayit in Model.SuresiDolanlar)
                    {
                        <tr>
                            <td>#@kayit.YanitId</td>
                            <td>@(kayit.AnketAdi ?? "-")</td>
                            <td>@kayit.BaslamaTarihi.ToString("dd.MM.yyyy")</td>
                            <td>@(kayit.TamamlanmaTarihi.HasValue ? kayit.TamamlanmaTarihi.Value.ToString("dd.MM.yyyy") : "-")</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Anonimlestir" asp-route-id="@kayit.YanitId"
                                      onsubmit="return confirm('Bu kaydın kişisel verileri kalıcı olarak silinecek. Devam etmek istiyor musunuz?');"
                                      class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-eraser me-1"></i> Anonimleştir
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
