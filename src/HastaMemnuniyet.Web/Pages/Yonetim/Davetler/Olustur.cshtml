@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Davetler.OlusturModel
@{
    ViewData["Title"] = "Yeni Davet";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-send me-2"></i>Yeni Davet Oluştur</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="card shadow-sm form-kart">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

            <div class="mb-3">
                <label asp-for="Girdi.AnketId" class="form-label">Anket</label>
                <select asp-for="Girdi.AnketId" asp-items="Model.AnketSecenekleri" class="form-select">
                    <option value="">-- Anket seçiniz --</option>
                </select>
                <span asp-validation-for="Girdi.AnketId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Girdi.HastaneId" class="form-label">Hastane</label>
                <select asp-for="Girdi.HastaneId" asp-items="Model.HastaneSecenekleri" class="form-select" id="hastaneSecim">
                    <option value="">-- Hastane seçiniz --</option>
                </select>
                <span asp-validation-for="Girdi.HastaneId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Girdi.BirimId" class="form-label">Birim</label>
                <select asp-for="Girdi.BirimId" class="form-select" id="birimSecim">
                    <option value="">Birim seçiniz (isteğe bağlı)</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Girdi.DoktorId" class="form-label">Doktor</label>
                <select asp-for="Girdi.DoktorId" class="form-select" id="doktorSecim">
                    <option value="">Doktor seçiniz (isteğe bağlı)</option>
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Girdi.GonderimKanali" class="form-label">Gönderim Kanalı</label>
                    <select asp-for="Girdi.GonderimKanali" asp-items="Model.KanalSecenekleri" class="form-select"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Girdi.TelefonNumarasi" class="form-label">Telefon Numarası</label>
                    <input asp-for="Girdi.TelefonNumarasi" class="form-control" placeholder="Örn. 05XX XXX XX XX" />
                    <span asp-validation-for="Girdi.TelefonNumarasi" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Girdi.HizmetTarihi" class="form-label">Hizmet Tarihi</label>
                <input asp-for="Girdi.HizmetTarihi" class="form-control" type="date" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i> Daveti Oluştur ve Gönder</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
