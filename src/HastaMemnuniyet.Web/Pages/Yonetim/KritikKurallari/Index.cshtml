@page
@model HastaMemnuniyet.Web.Pages.Yonetim.KritikKurallari.IndexModel
@{
    ViewData["Title"] = "Kritik Kurallar";
}

<div class="sayfa-baslik d-flex justify-content-between align-items-center flex-wrap">
    <h1><i class="bi bi-sliders me-2"></i>Kritik Geri Bildirim Kuralları</h1>
    <a asp-page="Ekle" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Yeni Kural</a>
</div>

@if (Model.Kurallar.Count == 0)
{
    <div class="alert alert-info">Henüz kural tanımlanmamış.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Kural Tipi</th>
                        <th>Anket</th>
                        <th>Eşik / Ölçüt</th>
                        <th class="text-center">Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kural in Model.Kurallar)
                    {
                        <tr>
                            <td><span class="badge bg-primary">@GorunumAdlari.KuralTipiAdi(kural.KuralTipi)</span></td>
                            <td>@(kural.AnketAdi ?? "Tüm anketler")</td>
                            <td>
                                @if (kural.KuralTipi == KuralTipi.PuanAlti)
                                {
                                    <span>@kural.EsikDegeri ve altı</span>
                                }
                                else if (kural.KuralTipi == KuralTipi.AnahtarKelime)
                                {
                                    <span>@kural.AnahtarKelimeler</span>
                                }
                                else if (kural.KuralTipi == KuralTipi.SecenekEslesmesi)
                                {
                                    <span>Seçenek #@kural.HedefSecenekId</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (kural.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Aktiflik" class="d-inline">
                                    <input type="hidden" name="id" value="@kural.Id" />
                                    <input type="hidden" name="aktifMi" value="@((!kural.AktifMi).ToString().ToLowerInvariant())" />
                                    @if (kural.AktifMi)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pause-circle me-1"></i> Pasifleştir</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-play-circle me-1"></i> Aktifleştir</button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
