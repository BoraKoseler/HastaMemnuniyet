@page
@model HastaMemnuniyet.Web.Pages.Yonetim.KritikGeriBildirimler.IndexModel
@{
    ViewData["Title"] = "Kritik Geri Bildirimler";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Kritik Geri Bildirimler</h1>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-3">
        <label class="form-label">Başlangıç Tarihi</label>
        <input asp-for="Baslangic" class="form-control" type="date" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label">Bitiş Tarihi</label>
        <input asp-for="Bitis" class="form-control" type="date" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label">Hastane</label>
        <select asp-for="HastaneId" asp-items="Model.HastaneSecenekleri" class="form-select">
            <option value="">Tüm hastaneler</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="form-check mt-4">
            <input asp-for="SadeceAcik" class="form-check-input" type="checkbox" />
            <label asp-for="SadeceAcik" class="form-check-label">Yalnızca aksiyon açılmamışlar</label>
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filtrele</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

@if (Model.KritikGeriBildirimler.Count == 0)
{
    <div class="alert alert-info">Gösterilecek kritik geri bildirim bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Hastane / Birim</th>
                        <th>Kural</th>
                        <th>Açıklama</th>
                        <th class="text-center">Aksiyon</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kb in Model.KritikGeriBildirimler)
                    {
                        <tr>
                            <td>@kb.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @(kb.HastaneAdi ?? "-")
                                @if (!string.IsNullOrWhiteSpace(kb.BirimAdi))
                                {
                                    <span class="text-muted small d-block">@kb.BirimAdi</span>
                                }
                            </td>
                            <td>
                                @if (kb.KuralTipi.HasValue)
                                {
                                    <span class="badge bg-danger">@GorunumAdlari.KuralTipiAdi(kb.KuralTipi.Value)</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@kb.Aciklama</td>
                            <td class="text-center">
                                @if (kb.AksiyonSayisi > 0)
                                {
                                    <span class="badge bg-success">@kb.AksiyonSayisi</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Yok</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Detay" asp-route-id="@kb.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
