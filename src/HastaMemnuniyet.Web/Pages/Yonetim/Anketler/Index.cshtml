@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Anketler.IndexModel
@{
    ViewData["Title"] = "Anketler";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-clipboard2-check me-2"></i>Anketler</h1>
    <a asp-page="Ekle" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Yeni Anket Ekle</a>
</div>

@if (Model.Anketler.Count == 0)
{
    <div class="alert alert-info">Henüz kayıtlı anket bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Tür</th>
                        <th>Sürüm</th>
                        <th>Soru Sayısı</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var anket in Model.Anketler)
                    {
                        <tr>
                            <td>@anket.Ad</td>
                            <td><span class="badge bg-info text-dark">@GorunumAdlari.AnketTuruAdi(anket.AnketTuru)</span></td>
                            <td>v@anket.SurumNo</td>
                            <td>@anket.SoruSayisi</td>
                            <td>
                                @if (anket.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Sorular" asp-route-id="@anket.Id" class="btn btn-sm btn-outline-success"><i class="bi bi-list-check"></i> Sorular</a>
                                <a asp-page="Duzenle" asp-route-id="@anket.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
                                <a asp-page="Surumler" asp-route-id="@anket.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clock-history"></i> Geçmiş Sürümler</a>
                                <a asp-page="Sil" asp-route-id="@anket.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
