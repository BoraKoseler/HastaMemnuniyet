@page "{id:int}"
@model HastaMemnuniyet.Web.Pages.Yonetim.Anketler.SurumlerModel
@{
    ViewData["Title"] = "Geçmiş Sürümler";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-clock-history me-2"></i>Geçmiş Sürümler</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<p class="text-muted">Anket: <strong>@Model.AnketAdi</strong></p>

@if (Model.Surumler.Count == 0)
{
    <div class="alert alert-info">Bu ankete ait sürüm bulunamadı.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sürüm</th>
                        <th>Ad</th>
                        <th>Soru Sayısı</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var surum in Model.Surumler)
                    {
                        <tr>
                            <td>v@surum.SurumNo</td>
                            <td>@surum.Ad</td>
                            <td>@surum.SoruSayisi</td>
                            <td>
                                @if (surum.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Sorular" asp-route-id="@surum.Id" class="btn btn-sm btn-outline-success"><i class="bi bi-list-check"></i> Sorular</a>
                                <a asp-page="Duzenle" asp-route-id="@surum.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
