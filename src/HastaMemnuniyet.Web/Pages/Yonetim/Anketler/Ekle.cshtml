@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Anketler.EkleModel
@{
    ViewData["Title"] = "Yeni Anket";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-clipboard2-check me-2"></i>Yeni Anket Ekle</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="card shadow-sm form-kart">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

            <div class="mb-3">
                <label asp-for="Girdi.Ad" class="form-label">Anket Adı</label>
                <input asp-for="Girdi.Ad" class="form-control" />
                <span asp-validation-for="Girdi.Ad" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Aciklama" class="form-label">Açıklama</label>
                <textarea asp-for="Girdi.Aciklama" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Girdi.Aciklama" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Girdi.AnketTuru" class="form-label">Anket Türü</label>
                    <select asp-for="Girdi.AnketTuru" asp-items="Model.TurSecenekleri" class="form-select"></select>
                    <span asp-validation-for="Girdi.AnketTuru" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Girdi.TahminiSureDakika" class="form-label">Tahmini Süre (dakika)</label>
                    <input asp-for="Girdi.TahminiSureDakika" class="form-control" type="number" min="0" max="240" />
                    <span asp-validation-for="Girdi.TahminiSureDakika" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.GizlilikMetni" class="form-label">Gizlilik Metni</label>
                <textarea asp-for="Girdi.GizlilikMetni" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Girdi.GizlilikMetni" class="text-danger small"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Girdi.AktifMi" class="form-check-input" />
                <label asp-for="Girdi.AktifMi" class="form-check-label">Aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Kaydet</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
