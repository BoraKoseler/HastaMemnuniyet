@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Aksiyonlar.EkleModel
@{
    ViewData["Title"] = "Yeni Aksiyon";
}

<div class="sayfa-baslik d-flex justify-content-between align-items-center flex-wrap">
    <h1><i class="bi bi-plus-circle me-2"></i>Yeni İyileştirme Aksiyonu</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="form-kart">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input asp-for="Girdi.KritikGeriBildirimId" type="hidden" />

        <div class="mb-3">
            <label asp-for="Girdi.Baslik" class="form-label"></label>
            <input asp-for="Girdi.Baslik" class="form-control" />
            <span asp-validation-for="Girdi.Baslik" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Girdi.Aciklama" class="form-label"></label>
            <textarea asp-for="Girdi.Aciklama" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Girdi.Aciklama" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.HastaneId" class="form-label"></label>
                <select asp-for="Girdi.HastaneId" asp-items="Model.HastaneSecenekleri" class="form-select" id="hastaneSecim">
                    <option value="">Seçiniz...</option>
                </select>
                <span asp-validation-for="Girdi.HastaneId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.BirimId" class="form-label"></label>
                <select asp-for="Girdi.BirimId" asp-items="Model.BirimSecenekleri" class="form-select" id="birimSecim">
                    <option value="">(İsteğe bağlı)</option>
                </select>
                <span asp-validation-for="Girdi.BirimId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.DoktorId" class="form-label"></label>
                <select asp-for="Girdi.DoktorId" asp-items="Model.DoktorSecenekleri" class="form-select" id="doktorSecim">
                    <option value="">(İsteğe bağlı)</option>
                </select>
                <span asp-validation-for="Girdi.DoktorId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.SorumluKullaniciId" class="form-label"></label>
                <select asp-for="Girdi.SorumluKullaniciId" asp-items="Model.SorumluSecenekleri" class="form-select">
                    <option value="">Seçiniz...</option>
                </select>
                <span asp-validation-for="Girdi.SorumluKullaniciId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.Oncelik" class="form-label"></label>
                <select asp-for="Girdi.Oncelik" asp-items="Model.OncelikSecenekleri" class="form-select"></select>
                <span asp-validation-for="Girdi.Oncelik" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Girdi.HedefTarih" class="form-label"></label>
                <input asp-for="Girdi.HedefTarih" class="form-control" type="date" />
                <span asp-validation-for="Girdi.HedefTarih" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Kaydet</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
