@page "{id}"
@model HastaMemnuniyet.Web.Pages.Yonetim.Kullanicilar.DuzenleModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-person-gear me-2"></i>Kullanıcı Düzenle</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="card shadow-sm form-kart">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

            <input type="hidden" asp-for="KullaniciId" />

            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <input class="form-control" value="@Model.AdSoyad" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">E-posta</label>
                <input class="form-control" value="@Model.Eposta" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Rol" class="form-label">Rol</label>
                <select asp-for="Rol" asp-items="Model.RolSecenekleri" class="form-select">
                    <option value="">-- Rol seçiniz --</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="AktifMi" class="form-check-input" />
                <label asp-for="AktifMi" class="form-check-label">Aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Kaydet</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
