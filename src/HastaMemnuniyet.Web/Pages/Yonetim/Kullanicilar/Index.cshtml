@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Kullanicilar.IndexModel
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-people me-2"></i>Kullanıcılar</h1>
    <a asp-page="Ekle" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Yeni Kullanıcı Ekle</a>
</div>

@if (Model.Kullanicilar.Count == 0)
{
    <div class="alert alert-info">Henüz kayıtlı kullanıcı bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Rol</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kullanici in Model.Kullanicilar)
                    {
                        <tr>
                            <td>@kullanici.Ad @kullanici.Soyad</td>
                            <td>@kullanici.Eposta</td>
                            <td>
                                @if (kullanici.Roller.Count == 0)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    @foreach (var rol in kullanici.Roller)
                                    {
                                        <span class="badge bg-primary me-1">@rol</span>
                                    }
                                }
                            </td>
                            <td>
                                @if (kullanici.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Duzenle" asp-route-id="@kullanici.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
