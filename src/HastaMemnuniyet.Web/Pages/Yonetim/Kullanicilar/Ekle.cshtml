@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Kullanicilar.EkleModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-person-plus me-2"></i>Yeni Kullanıcı Ekle</h1>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Listeye Dön</a>
</div>

<div class="card shadow-sm form-kart">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none;")"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Girdi.Ad" class="form-label">Ad</label>
                    <input asp-for="Girdi.Ad" class="form-control" />
                    <span asp-validation-for="Girdi.Ad" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Girdi.Soyad" class="form-label">Soyad</label>
                    <input asp-for="Girdi.Soyad" class="form-control" />
                    <span asp-validation-for="Girdi.Soyad" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Eposta" class="form-label">E-posta</label>
                <input asp-for="Girdi.Eposta" class="form-control" type="email" />
                <span asp-validation-for="Girdi.Eposta" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Parola" class="form-label">Parola</label>
                <input asp-for="Girdi.Parola" class="form-control" type="password" />
                <span asp-validation-for="Girdi.Parola" class="text-danger small"></span>
                <div class="form-text">En az 6 karakter; büyük/küçük harf, rakam ve özel karakter içermelidir.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Girdi.Rol" class="form-label">Rol</label>
                <select asp-for="Girdi.Rol" asp-items="Model.RolSecenekleri" class="form-select">
                    <option value="">-- Rol seçiniz --</option>
                </select>
                <span asp-validation-for="Girdi.Rol" class="text-danger small"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Girdi.AktifMi" class="form-check-input" />
                <label asp-for="Girdi.AktifMi" class="form-check-label">Aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Kaydet</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
