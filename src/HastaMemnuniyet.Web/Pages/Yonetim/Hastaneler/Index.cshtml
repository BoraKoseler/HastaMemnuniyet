@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Hastaneler.IndexModel
@{
    ViewData["Title"] = "Hastaneler";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-hospital me-2"></i>Hastaneler</h1>
    <a asp-page="Ekle" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Yeni Hastane Ekle
    </a>
</div>

@if (Model.Hastaneler.Count == 0)
{
    <div class="alert alert-info">Henüz kayıtlı hastane bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Kod</th>
                        <th>Telefon</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hastane in Model.Hastaneler)
                    {
                        <tr>
                            <td>@hastane.Ad</td>
                            <td><span class="badge bg-secondary">@hastane.Kod</span></td>
                            <td>@(string.IsNullOrWhiteSpace(hastane.Telefon) ? "-" : hastane.Telefon)</td>
                            <td>
                                @if (hastane.AktifMi)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Duzenle" asp-route-id="@hastane.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </a>
                                <a asp-page="Sil" asp-route-id="@hastane.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
