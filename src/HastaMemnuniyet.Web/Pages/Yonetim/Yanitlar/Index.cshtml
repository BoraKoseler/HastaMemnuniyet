@page
@model HastaMemnuniyet.Web.Pages.Yonetim.Yanitlar.IndexModel
@{
    ViewData["Title"] = "Yanıtlar";
}

<div class="sayfa-baslik">
    <h1><i class="bi bi-chat-square-text me-2"></i>Anket Yanıtları</h1>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-3">
        <label class="form-label">Başlangıç Tarihi</label>
        <input asp-for="Baslangic" class="form-control" type="date" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label">Bitiş Tarihi</label>
        <input asp-for="Bitis" class="form-control" type="date" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label">Hastane</label>
        <select asp-for="HastaneId" asp-items="Model.HastaneSecenekleri" class="form-select">
            <option value="">Tüm hastaneler</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-3">
        <label class="form-label">Anket</label>
        <select asp-for="AnketId" asp-items="Model.AnketSecenekleri" class="form-select">
            <option value="">Tüm anketler</option>
        </select>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i> Filtrele</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Temizle</a>
        <a asp-page="Index" asp-page-handler="Excel"
           asp-route-Baslangic="@(Model.Baslangic?.ToString("yyyy-MM-dd"))"
           asp-route-Bitis="@(Model.Bitis?.ToString("yyyy-MM-dd"))"
           asp-route-HastaneId="@Model.HastaneId"
           asp-route-AnketId="@Model.AnketId"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel'e Aktar
        </a>
    </div>
</form>

@if (Model.Yanitlar.Count == 0)
{
    <div class="alert alert-info">Gösterilecek yanıt bulunmuyor.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Anket</th>
                        <th>Hastane / Birim</th>
                        <th>Kanal</th>
                        <th>Tamamlanma</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var yanit in Model.Yanitlar)
                    {
                        <tr>
                            <td>@(yanit.AnketAdi ?? "-")</td>
                            <td>
                                @(yanit.HastaneAdi ?? "-")
                                @if (!string.IsNullOrWhiteSpace(yanit.BirimAdi))
                                {
                                    <span class="text-muted small d-block">@yanit.BirimAdi</span>
                                }
                            </td>
                            <td>@(yanit.KanalAdi ?? "-")</td>
                            <td>@(yanit.TamamlanmaTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td class="text-end">
                                <a asp-page="Detay" asp-route-id="@yanit.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3">
        <div class="text-muted small">
            Toplam @Model.ToplamKayit kayıt — Sayfa @Model.SayfaNo / @Model.ToplamSayfa
        </div>
        @if (Model.ToplamSayfa > 1)
        {
            <nav aria-label="Sayfalama">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.SayfaNo <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-SayfaNo="@(Model.SayfaNo - 1)"
                           asp-route-Baslangic="@(Model.Baslangic?.ToString("yyyy-MM-dd"))"
                           asp-route-Bitis="@(Model.Bitis?.ToString("yyyy-MM-dd"))"
                           asp-route-HastaneId="@Model.HastaneId"
                           asp-route-AnketId="@Model.AnketId">Önceki</a>
                    </li>
                    @for (var sayfa = 1; sayfa <= Model.ToplamSayfa; sayfa++)
                    {
                        <li class="page-item @(sayfa == Model.SayfaNo ? "active" : "")">
                            <a class="page-link"
                               asp-route-SayfaNo="@sayfa"
                               asp-route-Baslangic="@(Model.Baslangic?.ToString("yyyy-MM-dd"))"
                               asp-route-Bitis="@(Model.Bitis?.ToString("yyyy-MM-dd"))"
                               asp-route-HastaneId="@Model.HastaneId"
                               asp-route-AnketId="@Model.AnketId">@sayfa</a>
                        </li>
                    }
                    <li class="page-item @(Model.SayfaNo >= Model.ToplamSayfa ? "disabled" : "")">
                        <a class="page-link"
                           asp-route-SayfaNo="@(Model.SayfaNo + 1)"
                           asp-route-Baslangic="@(Model.Baslangic?.ToString("yyyy-MM-dd"))"
                           asp-route-Bitis="@(Model.Bitis?.ToString("yyyy-MM-dd"))"
                           asp-route-HastaneId="@Model.HastaneId"
                           asp-route-AnketId="@Model.AnketId">Sonraki</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
