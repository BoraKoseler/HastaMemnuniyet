@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
    var girisYapildi = User.Identity is { IsAuthenticated: true };
}

<div class="px-3 py-5 text-center">
    <i class="bi bi-heart-pulse-fill text-primary" style="font-size:3.5rem;"></i>
    <h1 class="display-5 fw-bold mt-3">Hasta Memnuniyet Anketi Yönetim Sistemi</h1>
    <div class="col-lg-7 mx-auto">
        <p class="lead mb-4">
            Hastanelerin, birimlerin ve doktorların hizmet kalitesini ölçmek için anket oluşturun,
            hastalara SMS ile davet gönderin ve sonuçları anlık olarak takip edin.
        </p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            @if (girisYapildi)
            {
                <a asp-page="/Yonetim/Dashboard/Index" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-speedometer2 me-1"></i> Panele Git
                </a>
            }
            else
            {
                <a asp-page="/Hesap/Giris" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4 py-4">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body">
                <i class="bi bi-clipboard2-pulse text-primary" style="font-size:2rem;"></i>
                <h5 class="mt-3">Anket Yönetimi</h5>
                <p class="text-muted small mb-0">Farklı hasta türleri için esnek soru tipleriyle anketler tasarlayın.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body">
                <i class="bi bi-send-check text-primary" style="font-size:2rem;"></i>
                <h5 class="mt-3">SMS Davet</h5>
                <p class="text-muted small mb-0">Hastalara benzersiz bağlantılarla anket davetleri gönderin.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body">
                <i class="bi bi-graph-up-arrow text-primary" style="font-size:2rem;"></i>
                <h5 class="mt-3">Raporlama</h5>
                <p class="text-muted small mb-0">Hastane ve birim bazında memnuniyet puanlarını izleyin.</p>
            </div>
        </div>
    </div>
</div>
