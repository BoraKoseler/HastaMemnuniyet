@page "/tanitim"
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "_Layout";
    var girisYapildi = User.Identity is { IsAuthenticated: true };
}

@* ───────── ANKET TAMAMLANDI BİLDİRİMİ (Toast) ───────── *@
@if (Model.AnketTamamlandi)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:1100;">
        <div id="anketToast" class="toast show align-items-center text-bg-success border-0 shadow-lg" role="alert">
            <div class="d-flex">
                <div class="toast-body fs-6">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Anketiniz başarıyla tamamlandı. Katılımınız için teşekkür ederiz!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
    <script>
        // 6 saniye sonra otomatik kapat
        setTimeout(function() {
            var t = document.getElementById('anketToast');
            if (t) { var bsToast = bootstrap.Toast.getOrCreateInstance(t); bsToast.hide(); }
        }, 6000);
    </script>
}

@* ───────── HERO BÖLÜMÜ ───────── *@
<section class="anasayfa-hero position-relative overflow-hidden text-white"
         style="background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 50%, #084298 100%); margin: -1rem -0.75rem 0;">
    <div class="container py-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="bi bi-heart-pulse-fill me-2"></i>Hasta Memnuniyet Sistemi
                </h1>
                <p class="lead opacity-90 mb-4" style="font-size:1.15rem;">
                    Hastanelerin, birimlerin ve doktorların hizmet kalitesini ölçün; SMS veya QR kod ile
                    anket gönderin; NPS, anahtar kelime analizi ve doktor karnesi gibi güçlü raporlarla
                    sağlık hizmetlerini sürekli iyileştirin.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    @if (girisYapildi)
                    {
                        <a asp-page="/Yonetim/Dashboard/Index" class="btn btn-light btn-lg px-4 fw-semibold text-primary">
                            <i class="bi bi-speedometer2 me-1"></i> Panele Git
                        </a>
                    }
                    else
                    {
                        <a asp-page="/Hesap/Giris" class="btn btn-light btn-lg px-4 fw-semibold text-primary">
                            <i class="bi bi-speedometer2 me-1"></i> Panele Git
                        </a>
                    }
                    <a href="#ozellikler" class="btn btn-outline-light btn-lg px-4">
                        <i class="bi bi-arrow-down-circle me-1"></i> Keşfet
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <i class="bi bi-clipboard2-pulse-fill" style="font-size:12rem; opacity:0.15;"></i>
            </div>
        </div>
    </div>
    @* Alt dalga efekti *@
    <div style="position:absolute; bottom:0; left:0; right:0; overflow:hidden; line-height:0;">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" style="width:100%; height:60px;">
            <path d="M0,80 C300,120 900,0 1200,80 L1200,120 L0,120 Z" fill="#ffffff"></path>
        </svg>
    </div>
</section>

@* ───────── İSTATİSTİK KARTLARI ───────── *@
<section class="container py-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Rakamlarla Sistemimiz</h2>
        <p class="text-muted">Gerçek zamanlı verilerle ölçek ve güvenilirlik</p>
    </div>
    <div class="row g-4 justify-content-center">
        @* Hastane *@
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm text-center h-100 istatistik-kart kart-mavi">
                <div class="card-body py-4">
                    <i class="bi bi-hospital text-primary" style="font-size:2rem;"></i>
                    <div class="kart-deger mt-2">@IndexModel.ArtiFormatla(Model.HastaneSayisi)</div>
                    <div class="kart-etiket">Hastane</div>
                </div>
            </div>
        </div>
        @* Doktor *@
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm text-center h-100 istatistik-kart kart-yesil">
                <div class="card-body py-4">
                    <i class="bi bi-person-badge text-success" style="font-size:2rem;"></i>
                    <div class="kart-deger mt-2">@IndexModel.ArtiFormatla(Model.DoktorSayisi)</div>
                    <div class="kart-etiket">Doktor</div>
                </div>
            </div>
        </div>
        @* Anket *@
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm text-center h-100 istatistik-kart kart-turkuaz">
                <div class="card-body py-4">
                    <i class="bi bi-journal-check text-info" style="font-size:2rem;"></i>
                    <div class="kart-deger mt-2">@IndexModel.ArtiFormatla(Model.AnketSayisi)</div>
                    <div class="kart-etiket">Anket</div>
                </div>
            </div>
        </div>
        @* Yanıt *@
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm text-center h-100 istatistik-kart kart-turuncu">
                <div class="card-body py-4">
                    <i class="bi bi-chat-dots text-warning" style="font-size:2rem;"></i>
                    <div class="kart-deger mt-2">@IndexModel.ArtiFormatla(Model.YanitSayisi)</div>
                    <div class="kart-etiket">Yanıt</div>
                </div>
            </div>
        </div>
        @* Ortalama Puan *@
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm text-center h-100 istatistik-kart" style="border-top:3px solid #6f42c1 !important;">
                <div class="card-body py-4">
                    <i class="bi bi-star-fill text-purple" style="font-size:2rem; color:#6f42c1;"></i>
                    <div class="kart-deger mt-2" style="color:#6f42c1;">@IndexModel.PuanFormatla(Model.OrtalamaPuan)</div>
                    <div class="kart-etiket">Ort. Puan</div>
                </div>
            </div>
        </div>
        @* Davet *@
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm text-center h-100 istatistik-kart" style="border-top:3px solid #d63384 !important;">
                <div class="card-body py-4">
                    <i class="bi bi-send-fill" style="font-size:2rem; color:#d63384;"></i>
                    <div class="kart-deger mt-2" style="color:#d63384;">@IndexModel.ArtiFormatla(Model.DavetSayisi)</div>
                    <div class="kart-etiket">Davet</div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ───────── ÖZELLİKLER BÖLÜMÜ ───────── *@
<section id="ozellikler" class="py-5" style="background-color:#f8f9fa;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary">Neler Yapabilirsiniz?</h2>
            <p class="text-muted">Anket yönetiminden gelişmiş analitiğe, tek platformda</p>
        </div>
        <div class="row g-4">
            @* Satır 1 *@
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px;">
                            <i class="bi bi-clipboard2-pulse text-primary" style="font-size:1.75rem;"></i>
                        </div>
                        <h5 class="fw-semibold">Esnek Anket Tasarımı</h5>
                        <p class="text-muted small mb-0">Puanlama, tek/çoklu seçim, evet/hayır, açık uçlu ve NPS dahil 6 farklı soru tipiyle, koşullu görünürlük desteğiyle anketler oluşturun.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px;">
                            <i class="bi bi-send-check text-success" style="font-size:1.75rem;"></i>
                        </div>
                        <h5 class="fw-semibold">SMS &amp; QR Kod Davet</h5>
                        <p class="text-muted small mb-0">Hastalara SMS ile benzersiz anket bağlantıları gönderin veya QR kod kampanyaları oluşturup kliniklere asın.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-info bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px;">
                            <i class="bi bi-speedometer2 text-info" style="font-size:1.75rem;"></i>
                        </div>
                        <h5 class="fw-semibold">Canlı Dashboard</h5>
                        <p class="text-muted small mb-0">Hastane ve birim bazında ortalama puanlar, yanıt oranları, NPS skoru ve kritik geri bildirimleri anlık takip edin.</p>
                    </div>
                </div>
            </div>
            @* Satır 2 *@
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px;">
                            <i class="bi bi-graph-up-arrow text-warning" style="font-size:1.75rem;"></i>
                        </div>
                        <h5 class="fw-semibold">Gelişmiş Analitik</h5>
                        <p class="text-muted small mb-0">Anahtar kelime analizi, dönemsel karşılaştırma ve doktor performans karnesi ile veriye dayalı kararlar alın.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px;">
                            <i class="bi bi-shield-lock text-danger" style="font-size:1.75rem;"></i>
                        </div>
                        <h5 class="fw-semibold">KVKK Uyumu</h5>
                        <p class="text-muted small mb-0">Telefon numarası hash'leme, yapılandırılabilir saklama süreleri ve geri alınamaz anonimleştirme ile kişisel verileri koruyun.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px; height:64px; background-color:rgba(111,66,193,0.1);">
                            <i class="bi bi-file-earmark-excel" style="font-size:1.75rem; color:#6f42c1;"></i>
                        </div>
                        <h5 class="fw-semibold">Excel Dışa Aktarma</h5>
                        <p class="text-muted small mb-0">Yanıtları, doktor karnelerini ve raporları tek tıkla profesyonel Excel dosyalarına dönüştürün.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ───────── NASIL ÇALIŞIR ───────── *@
<section class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Nasıl Çalışır?</h2>
        <p class="text-muted">3 basit adımda hasta memnuniyetini ölçün</p>
    </div>
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:56px; height:56px; font-size:1.5rem; font-weight:bold;">1</div>
            <h5 class="fw-semibold">Anket Oluşturun</h5>
            <p class="text-muted small">Soru tiplerini ve koşullu mantığı belirleyerek kurumunuza özel anketler tasarlayın.</p>
        </div>
        <div class="col-md-4">
            <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:56px; height:56px; font-size:1.5rem; font-weight:bold;">2</div>
            <h5 class="fw-semibold">Hastalardan Geri Bildirim Alın</h5>
            <p class="text-muted small">SMS, QR kod veya doğrudan bağlantı ile hastaları ankete yönlendirin.</p>
        </div>
        <div class="col-md-4">
            <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:56px; height:56px; font-size:1.5rem; font-weight:bold;">3</div>
            <h5 class="fw-semibold">Analiz Edin ve İyileştirin</h5>
            <p class="text-muted small">Dashboard, raporlar ve doktor karnesiyle iyileştirme alanlarını tespit edip aksiyon alın.</p>
        </div>
    </div>
</section>

@* ───────── CTA BÖLÜMÜ ───────── *@
<section class="text-white py-5" style="background: linear-gradient(135deg, #0b5ed7, #084298);">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Sağlık Hizmet Kalitenizi Yükseltin</h2>
        <p class="lead opacity-90 mb-4">Hemen giriş yaparak anketlerinizi oluşturun ve veriye dayalı kararlar almaya başlayın.</p>
        @if (girisYapildi)
        {
            <a asp-page="/Yonetim/Dashboard/Index" class="btn btn-light btn-lg px-5 fw-semibold text-primary">
                <i class="bi bi-speedometer2 me-1"></i> Panele Git
            </a>
        }
        else
        {
            <a asp-page="/Hesap/Giris" class="btn btn-light btn-lg px-5 fw-semibold text-primary">
                <i class="bi bi-speedometer2 me-1"></i> Panele Git 
            </a>
        }
    </div>
</section>
