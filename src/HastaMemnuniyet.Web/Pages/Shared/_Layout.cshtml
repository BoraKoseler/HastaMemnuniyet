@using System.Security.Claims
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hasta Memnuniyet Sistemi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid px-3">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <i class="bi bi-heart-pulse-fill me-1"></i> Hasta Memnuniyet Sistemi
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#anaMenu"
                        aria-controls="anaMenu" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="anaMenu">
                    @if (User.Identity is not null && User.Identity.IsAuthenticated)
                    {
                        var yonetici = User.IsInRole(RolSabitleri.Admin);
                        var tamYetkili = yonetici || User.IsInRole(RolSabitleri.KaliteBirimi);
                        var kritikErisim = tamYetkili || User.IsInRole(RolSabitleri.BirimYoneticisi);
                        var ustYonetimErisim = yonetici || User.IsInRole(RolSabitleri.UstYonetim);
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                            @if (yonetici)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="kurumsalMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Kurumsal</a>
                                    <ul class="dropdown-menu" aria-labelledby="kurumsalMenu">
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Hastaneler/Index">Hastaneler</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Birimler/Index">Birimler</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Doktorlar/Index">Doktorlar</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Kullanicilar/Index">Kullanıcılar</a></li>
                                    </ul>
                                </li>
                            }
                            @if (tamYetkili)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="anketMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Anket Yönetimi</a>
                                    <ul class="dropdown-menu" aria-labelledby="anketMenu">
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Dashboard/Index">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Anketler/Index">Anketler</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Davetler/Index">Davetler</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Yanitlar/Index">Yanıtlar</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/QrKampanyalari/Index">QR Kampanyaları</a></li>
                                    </ul>
                                </li>
                            }
                            @if (kritikErisim)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="kritikMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Kritik & Aksiyon</a>
                                    <ul class="dropdown-menu" aria-labelledby="kritikMenu">
                                        <li><a class="dropdown-item" asp-page="/Yonetim/KritikGeriBildirimler/Index">Kritik Geri Bildirimler</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Aksiyonlar/Index">Aksiyonlar</a></li>
                                        @if (tamYetkili)
                                        {
                                            <li><a class="dropdown-item" asp-page="/Yonetim/KritikKurallari/Index">Kritik Kuralları</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                            @if (yonetici)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="sistemMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sistem</a>
                                    <ul class="dropdown-menu" aria-labelledby="sistemMenu">
                                        <li><a class="dropdown-item" asp-page="/Yonetim/VeriYonetimi/Index">Veri Yönetimi</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/DenetimKayitlari/Index">Denetim Kayıtları</a></li>
                                    </ul>
                                </li>
                            }
                            @if (ustYonetimErisim)
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Yonetim/UstYonetimDashboard/Index">Üst Yönetim Panosu</a></li>
                            }
                            @if (tamYetkili || ustYonetimErisim)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="raporlarMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Raporlar</a>
                                    <ul class="dropdown-menu" aria-labelledby="raporlarMenu">
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Raporlar/AnahtarKelimeAnalizi"><i class="bi bi-tags me-2"></i>Anahtar Kelime Analizi</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Raporlar/DonemselKarsilastirma"><i class="bi bi-arrow-left-right me-2"></i>Dönemsel Karşılaştırma</a></li>
                                        <li><a class="dropdown-item" asp-page="/Yonetim/Raporlar/DoktorKarnesi"><i class="bi bi-person-vcard me-2"></i>Doktor Karnesi</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center">
                            <li class="nav-item d-flex align-items-center text-white me-2">
                                <i class="bi bi-person-circle me-1"></i>
                                <span>@User.Identity!.Name</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Hesap/Cikis" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light">
                                        <i class="bi bi-box-arrow-right me-1"></i> Çıkış
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light" asp-page="/Hesap/Giris">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container my-4 flex-grow-1">
        <partial name="_Notifications" />
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-light border-top">
        <div class="container text-center text-muted">
            &copy; 2024 Hasta Memnuniyet Sistemi — Tüm hakları saklıdır.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
